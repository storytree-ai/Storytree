# Dependencies
node_modules/
.pnp.*
.yarn/*

# Build output
dist/
build/
# ...except the desktop app's own icon asset (a committed source file, not a build artifact):
# re-include the dir (so git will traverse it) then the icon itself.
!apps/desktop/build/
!apps/desktop/build/icon.ico
out/
*.tsbuildinfo
.turbo/
.vite/

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
# `pnpm gate:bg` run artifacts — a per-worktree log + its sibling `.exit` status file
# (the `.exit` does not match *.log above, so the whole dir is ignored here).
.gate-logs/

# Test / coverage
coverage/
.nyc_output/
# Playwright run artifacts (apps/studio UAT)
test-results/
playwright-report/

# Deferred / not produced today: DBOS is deferred (ADR-0019) and the store is
# keyless Cloud SQL (ADR-0021), so neither dir is generated now — kept ignored
# pre-emptively in case a future local-DBOS or local-Postgres path returns.
.dbos/
pgdata/

# Members (ADR-0043) are app-owned runtime state, not seed: the offline JSON
# backend writes apps/studio/data/users.json on the fly (the live source of truth is the
# events."user" projection in Cloud SQL). Never committed.
apps/studio/data/users.json

# Per-UAT-test attestations (ADR-0044) are app-owned runtime state too: the offline JSON backend
# writes apps/studio/data/attestations.json on the fly (the live source is events.attestation in
# Cloud SQL). Never committed.
apps/studio/data/attestations.json

# The offline JSON backend's assets store (ADR-0210) is app-owned runtime state: seeded on first
# read by deriving the corpus from the library's committed fixture + the library templates (the
# offline read/write store (the live source is the events library tables in Cloud SQL). This
# REPLACED the committed, generated apps/studio/data/assets.json, which was retired. Never committed.
apps/studio/data/assets.runtime.json

# Python bytecode caches. The research spikes' offline compositors import one another as modules
# (the camera-elevation sweep rebinds the interior fork's `compose.py` rather than copying it), which
# makes CPython write a __pycache__ beside a committed script. Interpreter-and-platform specific
# build output, never evidence.
__pycache__/
*.py[cod]

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Personal Claude Code overrides (per-machine, never shared)
.claude/settings.local.json

# Write-authority claim receipts (ADR-0257 D5) — per-session, per-machine authority artifacts
# stamped into the PRIMARY checkout by the claim ceremonies. Never shared, and never tracked:
# an untracked receipt would dirty the lobby, which ADR-0245 D5.2's gate arm reads as a session
# mutating the shared checkout — so minting one would red the gate it exists to protect.
.claude/receipts/

# Judge-panel working artifacts (anti-slop-adoption-arc, ADR-0407 D3). The panel procedure has the
# operator copy `oxlint.config.ts`, run the linter to JSON, and build a packet of judge briefs plus
# an answer key. None of it is evidence: the report is a ~800KB measurement of one moment, and the
# packet is byte-reproducible from its committed spec + seed + a fresh report. The KEY in particular
# must never be committed — it maps each "Rule A/B/C" label back to the rule it hides, so a committed
# key un-blinds every future re-run of the same spec. What IS committed is the spec and the record
# under `tools/oxlint/panels/`.
.oxlint.*.ts
.oxlint-*.json
.oxlint-*.err
.panel/
