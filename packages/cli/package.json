{
  "name": "@storytree/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "storytree CLI (ADR-0023): the agent's exploratory, just-in-time interface to the Library. Choose-your-own-adventure — every command emits a result + doctrine + next envelope.",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts",
    "./secrets": "./src/secrets.ts"
  },
  "bin": {
    "storytree": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../scripts/tsx-cache-off.mjs --import tsx scripts/validate-corpus.ts && bun test --preload ../../scripts/tsx-cache-off.mjs --timeout 300000 src/",
    "storytree": "tsx src/main.ts",
    "db": "tsx src/db-cli.ts"
  },
  "dependencies": {
    "@storytree/agent": "workspace:*",
    "@storytree/arc": "workspace:*",
    "@storytree/context-traversal-capture": "workspace:*",
    "@storytree/context-traversal-spawn": "workspace:*",
    "@storytree/context-traversal-transcript": "workspace:*",
    "@storytree/drive": "workspace:*",
    "@storytree/storage-protocol": "workspace:*",
    "@storytree/library": "workspace:*",
    "@storytree/notice-board": "workspace:*",
    "@storytree/orchestrator": "workspace:*",
    "@storytree/proof-protocol": "workspace:*",
    "esbuild": "^0.24.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript5": "npm:typescript@5.7.3",
    "typescript": "~7.0.2"
  }
}
